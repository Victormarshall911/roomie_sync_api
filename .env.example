# ==============================================================================
# RoomieSync Django + DRF Environment Configuration
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=roomiesync-django-super-secret-key-for-development-and-tests-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# Database Configuration
# Option A: DATABASE_URL (Preferred for Neon / Production with ?sslmode=require)
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# Option B: Individual variables (Used for local Postgres Docker)
DB_NAME=roomiesync
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5433

# ------------------------------------------------------------------------------
# Redis Configuration (Cache / Channel Layer / Celery Broker)
# Single instance with prefix isolation or distinct DBs
REDIS_URL=redis://127.0.0.1:6379/0
# Optional overrides:
# REDIS_CACHE_URL=redis://127.0.0.1:6379/0
# REDIS_CHANNELS_URL=redis://127.0.0.1:6379/1
# CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=True

# ------------------------------------------------------------------------------
# Cloudflare R2 / AWS S3 Storage Configuration
# If omitted or empty, backend gracefully falls back to local FileSystemStorage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
# For Cloudflare R2:
# AWS_S3_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=pub-<hash>.r2.dev or media.roomiesync.app

# ------------------------------------------------------------------------------
# Production Security (Active when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://roomiesync-api.onrender.com
