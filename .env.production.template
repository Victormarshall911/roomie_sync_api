# ==============================================================================
# RoomieSync Production Environment Credentials
# Copy this file to .env.production or paste your credentials here
# ==============================================================================

# ------------------------------------------------------------------------------
# Phase 1: Neon PostgreSQL Connection String
# Example: postgresql://neondb_owner:npg_xyz@ep-cold-wind-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# Phase 2: Hosted Redis Connection URL (Upstash or Render Redis)
# Example (Upstash): rediss://default:xyz@us1-quick-falcon-12345.upstash.io:6379
# Example (Render):  rediss://red-xyz:password@oregon-redis.render.com:6379
# ------------------------------------------------------------------------------
REDIS_URL=
CELERY_BROKER_URL=

# ------------------------------------------------------------------------------
# Phase 3: Cloudflare R2 / AWS S3 Storage Credentials
# For Cloudflare R2:
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=pub-<hash>.r2.dev or media.roomiesync.app
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=auto

# ------------------------------------------------------------------------------
# Phase 6: Live Deployed URLs (Assigned by Render after service creation)
# Example: LIVE_API_URL=https://roomiesync-api.onrender.com
# ------------------------------------------------------------------------------
LIVE_API_URL=
LIVE_WS_URL=
